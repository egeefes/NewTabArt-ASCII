{
  "manifest_version": 3,
  "name": "ASCII Animals New Tab",
  "version": "1.14.0",
  "description": "ASCII animals drift across your new tab, behind a search box with suggestions from your history and Google.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "search",
    "tabs",
    "history",
    "favicon"
  ],
  "commands": {
    "open-animals": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Alt+T"
      },
      "description": "Open a new animals tab"
    }
  },
  "host_permissions": [
    "https://suggestqueries.google.com/*"
  ]
}