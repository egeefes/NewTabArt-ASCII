{
  "manifest_version": 3,
  "name": "ASCII Animals New Tab",
  "version": "1.25.1",
  "description": "ASCII animals drift across your new tab, behind a search box with suggestions from your history and Google.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "search",
    "history",
    "tabs"
  ],
  "host_permissions": [
    "https://suggestqueries.google.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ascii-animals-newtab@egeefes",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "searchTerms"
        ]
      }
    }
  }
}
